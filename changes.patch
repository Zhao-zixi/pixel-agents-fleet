+
+/* Multi-provider / SSH control panel. Shares the office's color tokens. */
+.fleet-root,
+.fleet-root * {
+  font-family: 'Noto Sans SC', system-ui, sans-serif;
+}
+
+.fleet-root {
+  font-family: 'Noto Sans SC', system-ui, sans-serif;
+  position: absolute;
+  top: 12px;
+  left: 12px;
+  z-index: 40;
+  font-size: 14px;
+}
+.fleet-panel {
+  margin-top: 8px;
+  padding: 16px;
+  width: min(400px, calc(100vw - 24px));
+  max-height: calc(100dvh - 110px);
+  overflow: auto;
+  background: var(--color-bg);
+  color: var(--color-text);
+  border: 2px solid var(--color-border);
+}
+.fleet-title {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  font-size: 18px;
+}
+.fleet-title span,
+.fleet-muted {
+  font-size: 12px;
+  opacity: 0.7;
+}
+.fleet-muted {
+  margin: 8px 0 14px;
+}
+.fleet-panel label {
+  display: block;
+  margin: 10px 0 6px;
+}
+.fleet-panel select,
+.fleet-panel textarea {
+  display: block;
+  width: 100%;
+  background: var(--color-btn-bg);
+  color: inherit;
+  border: 2px solid var(--color-border);
+  padding: 8px;
+  font: inherit;
+}
+.fleet-panel textarea {
+  resize: vertical;
+  margin-bottom: 10px;
+}
+.fleet-path {
+  font-size: 11px;
+  overflow-wrap: anywhere;
+  opacity: 0.65;
+  margin: 6px 0;
+}
+.fleet-error {
+  padding: 8px;
+  border: 1px solid currentColor;
+  margin-top: 10px;
+  white-space: pre-wrap;
+}
+.fleet-runs {
+  margin-top: 16px;
+  display: grid;
+  gap: 8px;
+}
+.fleet-run {
+  border: 2px solid var(--color-border);
+  padding: 8px;
+}
+.fleet-selected {
+  border-color: var(--color-accent);
+}
+.fleet-run-select {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 4px 10px;
+  width: 100%;
+  text-align: left;
+  color: inherit;
+  cursor: pointer;
+}
+.fleet-run-select small {
+  grid-column: 1/-1;
+  opacity: 0.7;
+  overflow-wrap: anywhere;
+}
+.fleet-activity {
+  max-height: 42px;
+  overflow: hidden;
+}
+.fleet-actions {
+  display: flex;
+  gap: 6px;
+  margin-top: 8px;
+}
+.fleet-detail {
+  margin-top: 14px;
+}
+.fleet-detail pre {
+  font-family: 'Noto Sans SC', monospace;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  max-height: 240px;
+  overflow: auto;
+  font-size: 12px;
+  padding: 10px;
+  background: var(--color-btn-bg);
+}
+
+.fleet-root button {
+  font-family: inherit;
+  font-size: 14px;
+}
+
+.fleet-group-title {
+  display: flex;
+  justify-content: space-between;
+  gap: 10px;
+}
+.fleet-group-title strong {
+  overflow-wrap: anywhere;
+}
+.fleet-group-title span {
+  white-space: nowrap;
+  color: var(--vscode-descriptionForeground, #aaa);
+}
+.fleet-conversation {
+  margin-top: 10px;
+  padding: 8px;
+  border-left: 3px solid #777b9b;
+  background: #222433;
+}
+.fleet-conversation.fleet-selected {
+  border-left-color: #ac9bf2;
+  background: #303047;
+}
+.fleet-history {
+  margin-top: 16px;
+  font-size: 11px;
+  flex-wrap: wrap;
+}
+.fleet-actions {
+  flex-wrap: wrap;
+}
