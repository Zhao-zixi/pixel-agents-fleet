diff --git a/server/src/fleet/events.ts b/server/src/fleet/events.ts
new file mode 100644
index 0000000..ee7f75a
--- /dev/null
+++ b/server/src/fleet/events.ts
@@ -0,0 +1,164 @@
+import type { FleetProvider } from '../../../core/src/fleet.js';
+import { FLEET_MAX_SESSION_ID } from './profiles.js';
+
+export type FleetEvent =
+  | { kind: 'tool'; id: string; name: string; detail: string }
+  | { kind: 'toolEnd'; id: string }
+  | { kind: 'text'; text: string }
+  | { kind: 'error'; message: string }
+  | { kind: 'session'; id: string }
+  | { kind: 'turnStart' }
+  | { kind: 'waiting'; message: string }
+  | { kind: 'done' };
+
+function obj(x: unknown): Record<string, unknown> {
+  return x && typeof x === 'object' ? (x as Record<string, unknown>) : {};
+}
+function str(x: unknown): string {
+  return typeof x === 'string' ? x : '';
+}
+function detail(x: unknown): string {
+  const input = obj(x);
+  return str(input.file_path ?? input.path ?? input.command ?? input.pattern ?? input.query).slice(
+    0,
+    200,
+  );
+}
+
+/** Pure per-provider adapters. Unknown events are ignored, never interpreted as completion. */
+export function normalizeFleetEvent(provider: FleetProvider, raw: unknown): FleetEvent[] {
+  const r = obj(raw);
+  const type = r.type;
+  const events: FleetEvent[] = [];
+  const session = str(r.session_id ?? r.sessionID ?? r.thread_id ?? r.conversationId);
+  if (session) events.push({ kind: 'session', id: session });
+  const tool = (id: unknown, name: unknown, input: unknown) => {
+    if (typeof id === 'string')
+      events.push({ kind: 'tool', id, name: str(name) || 'Tool', detail: detail(input) });
+  };
+  if (provider === 'codex') {
+    if (type === 'turn.started') events.push({ kind: 'turnStart' });
+    const item = obj(r.item);
+    if (type === 'item.started' && !['agent_message', 'reasoning'].includes(str(item.type)))
+      tool(item.id, item.type, item);
+    if (type === 'item.completed') {
+      if (typeof item.id === 'string') events.push({ kind: 'toolEnd', id: item.id });
+      if (item.type === 'agent_message') events.push({ kind: 'text', text: str(item.text) });
+    }
+    if (type === 'turn.completed') events.push({ kind: 'done' });
+    if (type === 'error' || type === 'turn.failed')
+      events.push({
+        kind: 'error',
+        message: str(r.message ?? obj(r.error).message) || 'Codex failed',
+      });
+  } else if (provider === 'claude') {
+    const content = obj(r.message).content;
+    if (Array.isArray(content))
+      for (const part of content) {
+        const c = obj(part);
+        if (c.type === 'tool_use') tool(c.id, c.name, c.input);
+        if (c.type === 'tool_result' && typeof c.tool_use_id === 'string')
+          events.push({ kind: 'toolEnd', id: c.tool_use_id });
+        if (c.type === 'text' && type === 'assistant')
+          events.push({ kind: 'text', text: str(c.text) });
+      }
+    if (type === 'result')
+      events.push(
+        r.is_error
+          ? { kind: 'error', message: str(r.result) || JSON.stringify(r.errors ?? r.subtype) }
+          : { kind: 'done' },
+      );
+  } else if (provider === 'gemini') {
+    if (type === 'tool_use') tool(r.tool_id, r.tool_name, r.parameters);
+    if (type === 'tool_result' && typeof r.tool_id === 'string')
+      events.push({ kind: 'toolEnd', id: r.tool_id });
+    if (type === 'message' && r.role === 'assistant')
+      events.push({ kind: 'text', text: str(r.content) });
+    if (type === 'result')
+      events.push(
+        r.status === 'error' || r.error
+          ? { kind: 'error', message: str(obj(r.error).message) || 'Gemini failed' }
+          : { kind: 'done' },
+      );
+    if (type === 'error')
+      events.push({
+        kind: 'error',
+        message: str(r.message ?? obj(r.error).message) || 'Gemini error',
+      });
+  } else if (provider === 'opencode') {
+    const part = obj(r.part);
+    if (type === 'text') events.push({ kind: 'text', text: str(part.text) });
+    if (type === 'tool_use') {
+      tool(part.callID ?? part.id, part.tool, obj(part.state).input);
+      if (['completed', 'error'].includes(str(obj(part.state).status)))
+        events.push({ kind: 'toolEnd', id: str(part.callID ?? part.id) });
+    }
+    if (type === 'error')
+      events.push({
+        kind: 'error',
+        message: str(obj(obj(r.error).data).message ?? obj(r.error).message) || 'OpenCode failed',
+      });
+    // step_finish ends ONE model step, not the whole run. Process exit is authoritative.
+  } else {
+    if (type === 'conversation_start' || type === 'turn_start') events.push({ kind: 'turnStart' });
+    if (type === 'waiting')
+      events.push({ kind: 'waiting', message: str(r.message) || 'Waiting for input' });
+    if (type === 'tool_start') tool(r.id, r.name, r.input);
+    if (type === 'tool_end' && typeof r.id === 'string') events.push({ kind: 'toolEnd', id: r.id });
+    if (type === 'text') events.push({ kind: 'text', text: str(r.text) });
+    if (type === 'error') events.push({ kind: 'error', message: str(r.message) || 'Agent failed' });
+    if (type === 'done') events.push({ kind: 'done' });
+  }
+  return events;
+}
+
+export interface FleetPacket {
+  conversationId?: string;
+  title?: string;
+  events: FleetEvent[];
+}
+
+/** Explicit envelopes make interleaved streams unambiguous. Never guess from tool IDs. */
+export function parseFleetPacket(provider: FleetProvider, raw: unknown): FleetPacket {
+  const record = obj(raw);
+  const envelope = record.type === 'fleet.event';
+  if (
+    envelope &&
+    (!record.event || typeof record.event !== 'object' || Array.isArray(record.event))
+  ) {
+    throw new Error('fleet.event needs an event object');
+  }
+  const payload = envelope ? obj(record.event) : record;
+  const suppliedId = envelope
+    ? record.conversationId
+    : (payload.conversationId ?? payload.session_id ?? payload.sessionID ?? payload.thread_id);
+  if (
+    (envelope && suppliedId === undefined) ||
+    (suppliedId !== undefined &&
+      (typeof suppliedId !== 'string' ||
+        !suppliedId.trim() ||
+        suppliedId.length > FLEET_MAX_SESSION_ID ||
+        /[\x00-\x1f]/.test(suppliedId)))
+  ) {
+    throw new Error('Invalid conversationId / session ID');
+  }
+  const title = record.title;
+  if (
+    title !== undefined &&
+    (typeof title !== 'string' || title.length > FLEET_MAX_SESSION_ID || /[\x00-\x1f]/.test(title))
+  ) {
+    throw new Error('Invalid conversation title');
+  }
+  return {
+    conversationId: suppliedId as string | undefined,
+    title: typeof title === 'string' ? title : undefined,
+    events: normalizeFleetEvent(provider, payload).filter((event) => event.kind !== 'session'),
+  };
+}
+
+/** Normalize animation categories without coupling the office to every CLI's tool vocabulary. */
+export function animationTool(name: string): string {
+  if (/read|search|glob|grep|list|web|fetch/i.test(name)) return 'Read';
+  if (/edit|write|patch|file_change/i.test(name)) return 'Edit';
+  return 'Bash';
+}
diff --git a/server/src/fleet/profiles.ts b/server/src/fleet/profiles.ts
new file mode 100644
index 0000000..45ea264
--- /dev/null
+++ b/server/src/fleet/profiles.ts
@@ -0,0 +1,149 @@
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { FLEET_PROVIDERS, type FleetProfile } from '../../../core/src/fleet.js';
+
+export const FLEET_MAX_PROMPT = 16_000;
+export const FLEET_MAX_RUNNING = 24;
+export const FLEET_MAX_HISTORY = 100;
+export const FLEET_MAX_OUTPUT = 64_000;
+export const FLEET_MAX_LINE = 1_048_576;
+export const FLEET_ACTIVITY_TIMEOUT = 3000;
+export const FLEET_ARCHIVE_DELAY = 15_000;
+export const FLEET_MAX_CONVERSATIONS = 256;
+export const FLEET_MAX_CONVERSATIONS_PER_RUN = 64;
+export const FLEET_MAX_SESSION_ID = 200;
+
+function safeString(value: unknown, field: string): string {
+  if (typeof value !== 'string' || !value.trim() || value.includes('\0')) {
+    throw new Error(`Invalid fleet profile ${field}`);
+  }
+  return value;
+}
+
+export function parseProfiles(value: unknown): FleetProfile[] {
+  if (!Array.isArray(value) || value.length > FLEET_MAX_HISTORY) {
+    throw new Error('Fleet config must be an array of at most 100 profiles');
+  }
+  const ids = new Set<string>();
+  return value.map((raw: unknown) => {
+    if (!raw || typeof raw !== 'object') throw new Error('Invalid fleet profile');
+    const p = raw as Record<string, unknown>;
+    const id = safeString(p.id, 'id');
+    if (!/^[a-zA-Z0-9_-]+$/.test(id) || ids.has(id))
+      throw new Error(`Invalid/duplicate profile id: ${id}`);
+    ids.add(id);
+    if (!FLEET_PROVIDERS.includes(p.provider as FleetProfile['provider']))
+      throw new Error(`Unknown provider: ${String(p.provider)}`);
+    if (p.mode !== undefined && p.mode !== 'task' && p.mode !== 'interactive')
+      throw new Error('Invalid fleet mode');
+    const profile: FleetProfile = {
+      id,
+      name: safeString(p.name, 'name'),
+      provider: p.provider as FleetProfile['provider'],
+      cwd: safeString(p.cwd, 'cwd'),
+      mode: p.mode === 'interactive' ? 'interactive' : 'task',
+    };
+    if (p.ssh !== undefined) {
+      const host = safeString(p.ssh, 'ssh');
+      // No options, shell metacharacters, whitespace, or multiple @ separators.
+      if (!/^(?:[a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_\[][a-zA-Z0-9_.:\[\]-]*$/.test(host))
+        throw new Error('Invalid SSH destination');
+      profile.ssh = host;
+      if (!profile.cwd.startsWith('/')) throw new Error('SSH cwd must be an absolute POSIX path');
+    } else if (!path.isAbsolute(profile.cwd)) throw new Error('Local cwd must be absolute');
+    if (p.port !== undefined) {
+      if (
+        !profile.ssh ||
+        typeof p.port !== 'number' ||
+        !Number.isInteger(p.port) ||
+        p.port < 1 ||
+        p.port > 65535
+      )
+        throw new Error('Invalid SSH port');
+      profile.port = p.port;
+    }
+    if (p.command !== undefined) {
+      profile.command = safeString(p.command, 'command');
+      if (profile.command.startsWith('-')) throw new Error('Executable cannot start with -');
+    }
+    if (p.args !== undefined) {
+      if (
+        !Array.isArray(p.args) ||
+        !p.args.every((a) => typeof a === 'string' && !a.includes('\0'))
+      )
+        throw new Error('args must be a string array');
+      profile.args = p.args as string[];
+    }
+    if (profile.provider === 'custom' && !profile.command)
+      throw new Error('Custom profiles need command');
+    return profile;
+  });
+}
+
+export function loadProfiles(file?: string): FleetProfile[] {
+  if (file) return parseProfiles(JSON.parse(fs.readFileSync(file, 'utf8')));
+  return FLEET_PROVIDERS.filter((p) => p !== 'custom').map((provider) => ({
+    id: provider,
+    name: provider,
+    provider,
+    mode: 'task',
+    cwd: process.cwd(),
+  }));
+}
+
+/** POSIX shell quoting, used ONLY on the remote side of OpenSSH. */
+export function shellQuote(s: string): string {
+  return "'" + s.replace(/'/g, "'\\''") + "'";
+}
+
+export function buildFleetCommand(profile: FleetProfile, prompt: string) {
+  if (prompt.length > FLEET_MAX_PROMPT || prompt.includes('\0'))
+    throw new Error('Task is too long or contains NUL');
+  if (profile.mode === 'task' && !prompt.trim()) throw new Error('A task prompt is required');
+  const extra = profile.args ?? [];
+  let args: string[] = extra;
+  if (profile.mode === 'task') {
+    switch (profile.provider) {
+      case 'claude':
+        args = ['--output-format', 'stream-json', '--verbose', ...extra, '-p', '--', prompt];
+        break;
+      case 'codex':
+        args = ['exec', '--json', ...extra, '--', prompt];
+        break;
+      case 'gemini':
+        args = ['--output-format', 'stream-json', ...extra, `--prompt=${prompt}`];
+        break;
+      case 'opencode':
+        args = ['run', '--format', 'json', ...extra, '--', prompt];
+        break;
+      case 'custom':
+        args = extra.map((a) => (a === '{prompt}' ? prompt : a));
+        break;
+    }
+  }
+  const command = profile.command ?? profile.provider;
+  if (!profile.ssh) return { command, args, cwd: profile.cwd };
+  const remote = `cd ${shellQuote(profile.cwd)} && exec ${[command, ...args].map(shellQuote).join(' ')}`;
+  return {
+    command: 'ssh',
+    args: [
+      '-tt',
+      '-o',
+      'BatchMode=yes',
+      '-o',
+      'StrictHostKeyChecking=yes',
+      '-o',
+      'ConnectTimeout=10',
+      '-o',
+      'ServerAliveInterval=15',
+      '-o',
+      'ServerAliveCountMax=3',
+      ...(profile.port ? ['-p', String(profile.port)] : []),
+      '--',
+      profile.ssh,
+      `sh -lc ${shellQuote(remote)}`,
+    ],
+    cwd: process.cwd(),
+  };
+}
diff --git a/server/src/fleet/routes.ts b/server/src/fleet/routes.ts
new file mode 100644
index 0000000..f0b2298
--- /dev/null
+++ b/server/src/fleet/routes.ts
@@ -0,0 +1,124 @@
+import type { FastifyInstance, FastifyReply, FastifyRequest } from 'fastify';
+
+import { bearerTokenValid, isAllowedWebSocketOrigin, normalizeHostname } from '../wsAuth.js';
+import { FLEET_MAX_PROMPT } from './profiles.js';
+import type { FleetService } from './service.js';
+
+export function registerFleetRoutes(
+  app: FastifyInstance,
+  fleet: FleetService,
+  token: string,
+  hosts: ReadonlySet<string>,
+): void {
+  const authorize = async (req: FastifyRequest, reply: FastifyReply) => {
+    if (!bearerTokenValid(req.headers.authorization, token))
+      return reply.code(401).send({ error: 'Open the tokened URL printed by the server' });
+    const host = normalizeHostname(req.headers.host);
+    if (
+      !host ||
+      !hosts.has(host) ||
+      !isAllowedWebSocketOrigin(req.headers.origin, req.headers.host)
+    )
+      return reply.code(403).send({ error: 'Untrusted origin or host' });
+  };
+  app.get('/api/fleet', { preHandler: authorize }, async () => fleet.snapshot());
+  app.get<{ Params: { id: string } }>(
+    '/api/fleet/conversations/:id',
+    { preHandler: authorize },
+    async (req, reply) =>
+      fleet.getConversation(Number(req.params.id)) ??
+      reply.code(404).send({ error: 'Unknown conversation' }),
+  );
+  app.post<{ Params: { id: string }; Body: { visible: boolean } }>(
+    '/api/fleet/conversations/:id/visibility',
+    {
+      preHandler: authorize,
+      schema: {
+        body: {
+          type: 'object',
+          additionalProperties: false,
+          required: ['visible'],
+          properties: { visible: { type: 'boolean' } },
+        },
+      },
+    },
+    async (req, reply) => {
+      if (!fleet.getConversation(Number(req.params.id)))
+        return reply.code(404).send({ error: 'Unknown conversation' });
+      fleet.setConversationVisible(Number(req.params.id), req.body.visible);
+      return { ok: true };
+    },
+  );
+  app.post<{ Params: { id: string }; Body: Record<string, unknown> }>(
+    '/api/fleet/runs/:id/events',
+    {
+      preHandler: authorize,
+      bodyLimit: 64 * 1024,
+      schema: { body: { type: 'object' } },
+    },
+    async (req, reply) => {
+      if (!fleet.get(Number(req.params.id))) return reply.code(404).send({ error: 'Unknown run' });
+      try {
+        return { conversationId: fleet.ingest(Number(req.params.id), req.body) };
+      } catch (error) {
+        return reply
+          .code(400)
+          .send({ error: error instanceof Error ? error.message : 'Invalid event' });
+      }
+    },
+  );
+  app.get<{ Params: { id: string } }>(
+    '/api/fleet/runs/:id',
+    { preHandler: authorize },
+    async (req, reply) => {
+      const run = fleet.get(Number(req.params.id));
+      return run ?? reply.code(404).send({ error: 'Unknown run' });
+    },
+  );
+  app.post<{ Body: { profileId: string; prompt?: string } }>(
+    '/api/fleet/runs',
+    {
+      preHandler: authorize,
+      schema: {
+        body: {
+          type: 'object',
+          additionalProperties: false,
+          required: ['profileId'],
+          properties: {
+            profileId: { type: 'string', minLength: 1 },
+            prompt: { type: 'string', maxLength: FLEET_MAX_PROMPT },
+          },
+        },
+      },
+    },
+    async (req, reply) => {
+      try {
+        return reply
+          .code(201)
+          .send({ id: fleet.launch(req.body.profileId, req.body.prompt ?? '') });
+      } catch (err) {
+        return reply
+          .code(400)
+          .send({ error: err instanceof Error ? err.message : 'Launch failed' });
+      }
+    },
+  );
+  app.post<{ Params: { id: string } }>(
+    '/api/fleet/runs/:id/stop',
+    { preHandler: authorize },
+    async (req, reply) => {
+      if (!fleet.get(Number(req.params.id))) return reply.code(404).send({ error: 'Unknown run' });
+      fleet.stop(Number(req.params.id));
+      return { ok: true };
+    },
+  );
+  app.delete<{ Params: { id: string } }>(
+    '/api/fleet/runs/:id',
+    { preHandler: authorize },
+    async (req, reply) => {
+      if (!fleet.get(Number(req.params.id))) return reply.code(404).send({ error: 'Unknown run' });
+      fleet.dismiss(Number(req.params.id));
+      return { ok: true };
+    },
+  );
+}
diff --git a/server/src/fleet/service.ts b/server/src/fleet/service.ts
new file mode 100644
index 0000000..7eb5f7f
--- /dev/null
+++ b/server/src/fleet/service.ts
@@ -0,0 +1,541 @@
+import { randomUUID } from 'node:crypto';
+import { stripVTControlCharacters } from 'node:util';
+
+import type {
+  FleetConversation,
+  FleetProfile,
+  FleetRun,
+  FleetSnapshot,
+} from '../../../core/src/fleet.js';
+import { createAgentState } from '../agentState.js';
+import type { AgentStateStore } from '../agentStateStore.js';
+import { assignPaletteIfNeeded } from '../paletteAssigner.js';
+import type { PtySessionManager } from '../terminal/ptySessionManager.js';
+import type { AgentState } from '../types.js';
+import { animationTool, type FleetEvent, parseFleetPacket } from './events.js';
+import {
+  buildFleetCommand,
+  FLEET_ACTIVITY_TIMEOUT,
+  FLEET_ARCHIVE_DELAY,
+  FLEET_MAX_CONVERSATIONS,
+  FLEET_MAX_CONVERSATIONS_PER_RUN,
+  FLEET_MAX_HISTORY,
+  FLEET_MAX_LINE,
+  FLEET_MAX_OUTPUT,
+  FLEET_MAX_RUNNING,
+} from './profiles.js';
+
+interface ConversationState {
+  conversation: FleetConversation;
+  agent: AgentState;
+  manuallyHidden: boolean;
+  archiveTimer?: ReturnType<typeof setTimeout>;
+}
+interface RunState {
+  run: FleetRun;
+  conversations: Map<number, ConversationState>;
+  bySession: Map<string, number>;
+  buffer: string;
+  droppingLine: boolean;
+  stopped: boolean;
+  warnedUnscoped: boolean;
+  telemetry: boolean;
+  idleTimer?: ReturnType<typeof setTimeout>;
+}
+
+/** A run owns ONE PTY. Each conversation owns ONE character and its own tool/output state. */
+export class FleetService {
+  private readonly runs = new Map<number, RunState>();
+  private readonly conversations = new Map<number, ConversationState>();
+  private readonly internalRemovals = new Set<number>();
+  private readonly onRemoved = (id: number) => {
+    if (this.internalRemovals.has(id)) return;
+    const state = this.conversations.get(id);
+    if (state) {
+      state.conversation.visible = false;
+      state.manuallyHidden = true;
+      clearTimeout(state.archiveTimer);
+    }
+  };
+
+  constructor(
+    readonly profiles: readonly FleetProfile[],
+    private readonly store: AgentStateStore,
+    private readonly pty: PtySessionManager,
+    private readonly reserveClaudeSession?: (sessionId: string, cwd: string) => void,
+  ) {
+    store.on('agentRemoved', this.onRemoved);
+  }
+
+  snapshot(): FleetSnapshot {
+    return {
+      available: this.pty.isAvailable(),
+      reason: this.pty.unavailableReason(),
+      profiles: this.profiles.map(({ id, name, provider, mode, cwd, ssh }) => ({
+        id,
+        name,
+        provider,
+        mode,
+        cwd,
+        ssh,
+      })),
+      runs: [...this.runs.values()].map(({ run: { output: _output, ...run } }) => run),
+      conversations: [...this.conversations.values()].map(
+        ({ conversation: { output: _output, ...conversation } }) => conversation,
+      ),
+      maxRunning: FLEET_MAX_RUNNING,
+    };
+  }
+
+  get(id: number): FleetRun | undefined {
+    return this.runs.get(id)?.run;
+  }
+  getConversation(id: number): FleetConversation | undefined {
+    return this.conversations.get(id)?.conversation;
+  }
+  liveRunIds(): number[] {
+    return [...this.runs.values()].filter((r) => r.run.status === 'running').map((r) => r.run.id);
+  }
+  ownsSession(sessionId: unknown): boolean {
+    return (
+      typeof sessionId === 'string' &&
+      [...this.conversations.values()].some(
+        (s) => s.conversation.sessionId === sessionId || s.agent.sessionId === sessionId,
+      )
+    );
+  }
+
+  launch(profileId: string, prompt: string): number {
+    const profile = this.profiles.find((p) => p.id === profileId);
+    if (!profile) throw new Error('Unknown profile');
+    if (!this.pty.isAvailable())
+      throw new Error(this.pty.unavailableReason() ?? 'Terminal unavailable');
+    if (this.liveRunIds().length >= FLEET_MAX_RUNNING)
+      throw new Error('Concurrent agent limit reached');
+    while (this.runs.size >= FLEET_MAX_HISTORY) {
+      const oldest = [...this.runs.values()].find(({ run }) => run.status !== 'running');
+      if (!oldest) throw new Error('Fleet history is full');
+      this.dismiss(oldest.run.id);
+    }
+    if (this.conversations.size >= FLEET_MAX_CONVERSATIONS)
+      throw new Error('Conversation limit reached; remove finished Agent groups');
+    const sessionId = randomUUID();
+    const launchProfile =
+      profile.provider === 'claude'
+        ? { ...profile, args: [...(profile.args ?? []), '--session-id', sessionId] }
+        : profile;
+    const command = buildFleetCommand(launchProfile, prompt);
+    if (profile.provider === 'claude' && !profile.ssh)
+      this.reserveClaudeSession?.(sessionId, profile.cwd);
+    const id = this.store.nextAgentId.current++;
+    const session = this.pty.create({ agentId: id, ...command });
+    const run: FleetRun = {
+      id,
+      profileId,
+      name: profile.name,
+      provider: profile.provider,
+      mode: profile.mode,
+      host: profile.ssh ?? 'local',
+      cwd: profile.cwd,
+      status: 'running',
+      activity: profile.ssh ? 'SSH connecting' : 'Starting',
+      startedAt: Date.now(),
+      output: '',
+      ...(profile.provider === 'claude' ? { sessionId } : {}),
+    };
+    const state: RunState = {
+      run,
+      conversations: new Map(),
+      bySession: new Map(),
+      buffer: '',
+      droppingLine: false,
+      stopped: false,
+      warnedUnscoped: false,
+      telemetry: false,
+    };
+    this.runs.set(id, state);
+    // Reuse this placeholder for the first observed session: no duplicate startup character.
+    this.createConversation(state, id, run.sessionId, prompt.trim().slice(0, 80) || profile.name);
+    this.store.broadcast({ type: 'terminalSessionOpened', agentId: id });
+    session.onData((chunk) => this.onData(state, chunk));
+    session.onExit((exit) => {
+      clearTimeout(state.idleTimer);
+      if (!this.runs.has(id)) return;
+      if (state.buffer && !state.droppingLine) this.onLine(state, state.buffer);
+      state.buffer = '';
+      run.exitCode = exit.exitCode;
+      run.endedAt = Date.now();
+      const failed = [...state.conversations.values()].some(
+        (s) => s.conversation.status === 'failed',
+      );
+      run.status = state.stopped ? 'stopped' : exit.exitCode !== 0 || failed ? 'failed' : 'done';
+      run.activity = run.status === 'failed' ? `Failed (exit ${exit.exitCode})` : run.status;
+      for (const conversation of state.conversations.values()) {
+        // Completed conversations stay completed if a sibling or the transport later fails.
+        if (['running', 'waiting'].includes(conversation.conversation.status)) {
+          this.finish(
+            conversation,
+            state.stopped ? 'stopped' : exit.exitCode !== 0 ? 'failed' : 'done',
+            run.activity,
+          );
+        }
+      }
+      this.store.broadcast({ type: 'terminalSessionClosed', agentId: id, exitCode: exit.exitCode });
+      this.appendRun(state, `\n[${run.activity}]\n`);
+    });
+    return id;
+  }
+
+  /** Normalized ingestion also serves integrations which emit tagged events over HTTP. */
+  ingest(runId: number, raw: unknown): number | null {
+    const state = this.runs.get(runId);
+    if (!state || state.run.status !== 'running') throw new Error('Agent process is not running');
+    const packet = parseFleetPacket(state.run.provider, raw);
+    if (!packet.conversationId && packet.events.length === 0) return null;
+    let target: ConversationState | undefined;
+    if (packet.conversationId) {
+      const known = state.bySession.get(packet.conversationId);
+      if (known !== undefined) target = state.conversations.get(known);
+      else {
+        const first = state.conversations.values().next().value as ConversationState;
+        if (state.conversations.size === 1 && !first.conversation.sessionId) {
+          target = first;
+          target.conversation.sessionId = packet.conversationId;
+          target.agent.sessionId = packet.conversationId;
+          state.bySession.set(packet.conversationId, target.conversation.id);
+          state.run.sessionId = packet.conversationId;
+        } else {
+          if (
+            state.conversations.size >= FLEET_MAX_CONVERSATIONS_PER_RUN ||
+            this.conversations.size >= FLEET_MAX_CONVERSATIONS
+          )
+            throw new Error('Conversation limit reached');
+          target = this.createConversation(
+            state,
+            this.store.nextAgentId.current++,
+            packet.conversationId,
+            packet.title || `Conversation ${state.conversations.size + 1}`,
+          );
+        }
+      }
+    } else if (state.conversations.size === 1) target = state.conversations.values().next().value;
+    else {
+      if (!state.warnedUnscoped) {
+        this.appendRun(
+          state,
+          '[Unassigned event] Multiple conversations: supply conversationId on every event.\n',
+        );
+        state.warnedUnscoped = true;
+      }
+      return null;
+    }
+    if (!target) return null;
+    if (packet.conversationId) {
+      state.telemetry = true;
+      clearTimeout(state.idleTimer);
+    }
+    if (packet.title?.trim()) {
+      target.conversation.title = packet.title;
+      this.sendInfo(target);
+    }
+    for (const event of packet.events) this.apply(state, target, event);
+    return target.conversation.id;
+  }
+
+  /** Hide/show is a presentation operation. It NEVER kills a shared process. */
+  setConversationVisible(id: number, visible: boolean, manual = true): void {
+    const state = this.conversations.get(id);
+    if (!state) throw new Error('Unknown conversation');
+    clearTimeout(state.archiveTimer);
+    state.manuallyHidden = manual && !visible;
+    if (state.conversation.visible === visible) return;
+    state.conversation.visible = visible;
+    if (!visible) {
+      this.internalRemovals.add(id);
+      this.store.delete(id);
+      this.internalRemovals.delete(id);
+    } else {
+      this.store.set(id, state.agent);
+      this.sendInfo(state);
+      this.replay(state);
+    }
+  }
+
+  stop(id: number): void {
+    const state = this.runs.get(id);
+    if (!state) throw new Error('Unknown run');
+    if (state.run.status !== 'running') return;
+    state.stopped = true;
+    state.run.activity = 'Stopping';
+    this.pty.dispose(id);
+  }
+
+  dismiss(id: number): void {
+    const state = this.runs.get(id);
+    if (!state) throw new Error('Unknown run');
+    clearTimeout(state.idleTimer);
+    this.stop(id);
+    for (const [conversationId, conversation] of state.conversations) {
+      clearTimeout(conversation.archiveTimer);
+      this.setConversationVisible(conversationId, false);
+      this.conversations.delete(conversationId);
+    }
+    this.runs.delete(id);
+  }
+
+  dispose(): void {
+    for (const id of [...this.runs.keys()]) this.dismiss(id);
+    this.store.off('agentRemoved', this.onRemoved);
+  }
+
+  private createConversation(
+    run: RunState,
+    id: number,
+    sessionId: string | undefined,
+    title: string,
+  ): ConversationState {
+    const now = Date.now();
+    const conversation: FleetConversation = {
+      id,
+      runId: run.run.id,
+      sessionId,
+      title,
+      provider: run.run.provider,
+      host: run.run.host,
+      cwd: run.run.cwd,
+      status: 'running',
+      activity: 'Starting',
+      visible: true,
+      startedAt: now,
+      updatedAt: now,
+      output: '',
+    };
+    const agent = createAgentState({
+      id,
+      sessionId: sessionId ?? randomUUID(),
+      isExternal: false,
+      hooksOnly: true,
+      managedFleet: true,
+      projectDir: run.run.cwd,
+      jsonlFile: '',
+      providerId: run.run.provider,
+      directoryName: `${run.run.name} · ${run.run.host}`,
+      hookDelivered: true,
+    });
+    assignPaletteIfNeeded(agent, this.store);
+    const state: ConversationState = { conversation, agent, manuallyHidden: false };
+    run.conversations.set(id, state);
+    if (sessionId) run.bySession.set(sessionId, id);
+    this.conversations.set(id, state);
+    this.store.set(id, agent);
+    this.sendInfo(state);
+    this.store.broadcast({ type: 'agentStatus', id, status: 'active' });
+    return state;
+  }
+
+  private sendInfo(state: ConversationState): void {
+    const c = state.conversation;
+    state.agent.fleetConversation = {
+      runId: c.runId,
+      title: c.title,
+      provider: c.provider,
+      host: c.host,
+    };
+    if (c.visible)
+      this.store.broadcast({
+        type: 'fleetConversationInfo',
+        id: c.id,
+        ...state.agent.fleetConversation,
+      });
+  }
+
+  private replay(state: ConversationState): void {
+    const { agent, conversation: c } = state;
+    for (const [toolId, status] of agent.activeToolStatuses)
+      this.store.broadcast({
+        type: 'agentToolStart',
+        id: c.id,
+        toolId,
+        status,
+        toolName: agent.activeToolNames.get(toolId),
+      });
+    this.store.broadcast({
+      type: 'agentStatus',
+      id: c.id,
+      status: agent.isWaiting ? 'waiting' : 'active',
+      awaitingInput: agent.fleetAwaitingInput,
+    });
+  }
+
+  private appendRun(state: RunState, text: string): void {
+    state.run.output = (state.run.output + text).slice(-FLEET_MAX_OUTPUT);
+  }
+  private append(state: RunState, target: ConversationState, text: string): void {
+    target.conversation.output = (target.conversation.output + text).slice(-FLEET_MAX_OUTPUT);
+    this.appendRun(state, `[${target.conversation.title}] ${text}`);
+  }
+
+  private onData(state: RunState, chunk: string): void {
+    if (!this.runs.has(state.run.id)) return;
+    if (state.run.mode === 'interactive') {
+      // Terminal traffic cannot identify conversations. Use estimates only until a tagged integration takes over.
+      const target = state.conversations.values().next().value as ConversationState;
+      if (state.conversations.size === 1 && !state.telemetry) {
+        this.append(state, target, stripVTControlCharacters(chunk));
+        this.activate(target);
+        target.conversation.activity = 'Terminal output (activity estimate)';
+        clearTimeout(state.idleTimer);
+        state.idleTimer = setTimeout(() => {
+          target.conversation.activity = 'Terminal quiet (not a completion signal)';
+          this.clearTools(target, false);
+        }, FLEET_ACTIVITY_TIMEOUT);
+      } else this.appendRun(state, stripVTControlCharacters(chunk));
+      return;
+    }
+    for (const piece of chunk.split(/(?<=\n)/)) {
+      if (!state.droppingLine) {
+        state.buffer += piece;
+        if (state.buffer.length > FLEET_MAX_LINE) {
+          state.buffer = '';
+          state.droppingLine = true;
+          this.appendRun(state, '[Oversized event skipped]\n');
+        }
+      }
+      if (piece.endsWith('\n')) {
+        if (!state.droppingLine) this.onLine(state, state.buffer);
+        state.buffer = '';
+        state.droppingLine = false;
+      }
+    }
+  }
+
+  private onLine(state: RunState, line: string): void {
+    const clean = stripVTControlCharacters(line).trim();
+    if (!clean) return;
+    let raw: unknown;
+    try {
+      raw = JSON.parse(clean);
+    } catch {
+      if (state.conversations.size === 1)
+        this.append(state, state.conversations.values().next().value!, clean + '\n');
+      else this.appendRun(state, clean + '\n');
+      return;
+    }
+    try {
+      this.ingest(state.run.id, raw);
+    } catch (error) {
+      this.appendRun(
+        state,
+        `[Event rejected] ${error instanceof Error ? error.message : String(error)}\n`,
+      );
+    }
+  }
+
+  private activate(state: ConversationState): void {
+    clearTimeout(state.archiveTimer);
+    state.conversation.status = 'running';
+    state.agent.isWaiting = false;
+    state.agent.fleetAwaitingInput = false;
+    if (!state.conversation.visible && !state.manuallyHidden)
+      this.setConversationVisible(state.conversation.id, true, false);
+    if (state.conversation.visible)
+      this.store.broadcast({ type: 'agentStatus', id: state.conversation.id, status: 'active' });
+  }
+
+  private apply(run: RunState, state: ConversationState, event: FleetEvent): void {
+    const { conversation: c, agent } = state;
+    const id = c.id;
+    c.updatedAt = Date.now();
+    switch (event.kind) {
+      case 'session':
+        break; // identity is resolved before normalizing content
+      case 'turnStart':
+        this.activate(state);
+        c.activity = 'Working';
+        break;
+      case 'text':
+        if (c.status === 'done' || c.status === 'waiting') {
+          this.activate(state);
+          c.activity = 'Working';
+        }
+        this.append(run, state, event.text + '\n');
+        break;
+      case 'error':
+        this.append(run, state, `[Error] ${event.message}\n`);
+        this.finish(state, 'failed', event.message);
+        break;
+      case 'done':
+        if (c.status !== 'failed') this.finish(state, 'done', 'Done');
+        break;
+      case 'waiting':
+        clearTimeout(state.archiveTimer);
+        c.status = 'waiting';
+        c.activity = event.message;
+        this.clearTools(state, true);
+        if (!c.visible && !state.manuallyHidden) this.setConversationVisible(id, true, false);
+        break;
+      case 'tool': {
+        this.activate(state);
+        const status = `${event.name}${event.detail ? ': ' + event.detail : ''}`;
+        c.activity = status;
+        agent.activeToolIds.add(event.id);
+        agent.activeToolStatuses.set(event.id, status);
+        agent.activeToolNames.set(event.id, animationTool(event.name));
+        if (c.visible)
+          this.store.broadcast({
+            type: 'agentToolStart',
+            id,
+            toolId: event.id,
+            toolName: animationTool(event.name),
+            status,
+          });
+        this.append(run, state, `[Tool] ${status}\n`);
+        break;
+      }
+      case 'toolEnd':
+        agent.activeToolIds.delete(event.id);
+        agent.activeToolStatuses.delete(event.id);
+        agent.activeToolNames.delete(event.id);
+        if (c.visible) this.store.broadcast({ type: 'agentToolDone', id, toolId: event.id });
+        if (!agent.activeToolIds.size && c.status === 'running') c.activity = 'Working';
+        break;
+    }
+    run.run.activity = `${run.conversations.size} conversation(s)`;
+  }
+
+  private finish(
+    state: ConversationState,
+    status: 'done' | 'failed' | 'stopped',
+    activity: string,
+  ): void {
+    state.conversation.status = status;
+    state.conversation.activity = activity;
+    state.conversation.updatedAt = Date.now();
+    this.clearTools(state, status === 'failed');
+    clearTimeout(state.archiveTimer);
+    // Keep failures and questions visible for attention; completed/stopped work goes to history.
+    if (status === 'failed' && !state.conversation.visible && !state.manuallyHidden) {
+      this.setConversationVisible(state.conversation.id, true, false);
+    }
+    if (status !== 'failed' && state.conversation.visible && !state.manuallyHidden) {
+      state.archiveTimer = setTimeout(
+        () => this.setConversationVisible(state.conversation.id, false, false),
+        FLEET_ARCHIVE_DELAY,
+      );
+      state.archiveTimer.unref?.();
+    }
+  }
+
+  private clearTools(state: ConversationState, awaitingInput: boolean): void {
+    const { agent, conversation: c } = state;
+    agent.activeToolIds.clear();
+    agent.activeToolStatuses.clear();
+    agent.activeToolNames.clear();
+    agent.isWaiting = true;
+    agent.fleetAwaitingInput = awaitingInput;
+    if (c.visible) {
+      this.store.broadcast({ type: 'agentToolsClear', id: c.id });
+      this.store.broadcast({ type: 'agentStatus', id: c.id, status: 'waiting', awaitingInput });
+    }
+  }
+}
